{
  "manifest_version": 3,
  "name": "InterviewBit AI Solver",
  "version": "1.0.0",
  "description": "Solve InterviewBit problems using AI via OpenRouter",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.interviewbit.com/*",
    "https://openrouter.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.interviewbit.com/problems/*"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.interviewbit.com/problems/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IB AI Solver"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}